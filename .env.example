# ── Required ────────────────────────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Where leads go. Comma-separated; run `npm run chat-id` to find ids.
# Add :<topic id> to post into a forum topic, e.g. -1001234567890:42
TELEGRAM_CHAT_IDS=
# Sites allowed to send leads (scheme + host, no path). Use * only for testing.
ALLOWED_ORIGINS=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
# Language of Telegram messages and visitor-facing errors: uk | en
LOCALE=uk
TIMEZONE=Europe/Kyiv
# Max delivered leads per visitor IP: <count>/<window>, window in s, m or h
RATE_LIMIT=5/10m
# Submissions faster than this after the page loaded are treated as bots
MIN_FILL_SECONDS=3
# More links than this in the text fields is treated as spam
MAX_LINKS=2
# Where to send visitors after a plain (no-JavaScript) form post
SUCCESS_REDIRECT=
# Set to true behind nginx / Render / Railway / Cloudflare so the real visitor IP is used
TRUST_PROXY=false
# Serve the example form at /demo (for local testing)
DEMO_PAGE=true
